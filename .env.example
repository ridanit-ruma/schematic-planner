# =============================================================================
# Schematic Planner — environment
#
# Copy to `.env` and fill in. Every value here has a working local default
# except the secrets, which are intentionally blank so that an unconfigured
# deployment fails loudly at boot instead of running on a guessable key.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# apps/api
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001

# Public origin the API is reached at. Used to build absolute links (share URLs,
# the MCP endpoint shown in settings). Must be the externally visible value.
API_PUBLIC_URL=http://localhost:3001

# Where the SPA is served from. Used for redirects and share links.
APP_PUBLIC_URL=http://localhost:5173

# Comma-separated. Only these origins may call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set when the API sits behind a reverse proxy so that client IPs and the
# protocol are read from X-Forwarded-* instead of the socket.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://schematic:schematic@localhost:5432/schematic?schema=public

# -----------------------------------------------------------------------------
# Auth
#
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Leave blank to scope the refresh cookie to the request host.
COOKIE_DOMAIN=
# Send the refresh cookie only over HTTPS. Must be true in any real deployment.
COOKIE_SECURE=false

# Optional social login. Leave blank to hide the provider from the sign-in page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set false to close an instance to new sign-ups after the team has registered.
ALLOW_REGISTRATION=true

# -----------------------------------------------------------------------------
# Rate limiting
#
# Two allowances per window: one for ordinary traffic and a much tighter one for
# anything that checks a credential — sign-in, registration, invitations and
# share links all answer yes or no to a guess.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# -----------------------------------------------------------------------------
# Collaboration
#
# A Y.Doc is persisted after the document has been quiet for DEBOUNCE_MS, and
# unconditionally every MAX_WAIT_MS so a continuously edited plan still saves.
# -----------------------------------------------------------------------------
COLLAB_PERSIST_DEBOUNCE_MS=2000
COLLAB_PERSIST_MAX_WAIT_MS=10000

# -----------------------------------------------------------------------------
# apps/web  (development only)
#
# In production the SPA reads these at runtime from /config.js, so one build
# runs in every environment. See apps/web/public/config.js.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_COLLAB_URL=ws://localhost:3001/collab

# -----------------------------------------------------------------------------
# apps/www
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:5173
