# One origin for the whole product.
#
#   /                     the marketing site and its documentation
#   /login /workspace/*   the application
#   /api/*                the API, with the prefix stripped
#
# Serving both from one address is not only tidier: it makes the session cookie
# same-site, which means no CORS configuration and no cross-site cookie rules to
# get wrong. Everything below follows from that one decision.

{
	admin off
	auto_https {$AUTO_HTTPS:off}
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	# The API. handle_path removes /api before proxying, so the server keeps its
	# own paths — /auth/login, /mcp, /collab/:planId — and the browser reaches
	# them under one origin.
	handle_path /api/* {
		reverse_proxy {$UPSTREAM_API:api:3001}
	}

	# The application's own assets. Named explicitly so they cannot be confused
	# with the marketing site's.
	handle /assets/* {
		root * {$APP_ROOT:/srv/app}
		file_server
	}
	handle /config.js {
		root * {$APP_ROOT:/srv/app}
		file_server
	}

	# A link unfurler asking about a share link gets a card naming the plan; a
	# person gets the application, which is what the rewrite below never touches.
	#
	# Only a share link. A link to anything else in the application must not say
	# what is behind it — an unfurl is rendered for everybody in the channel it
	# was pasted into, and most of them cannot open the plan. A share link is the
	# one address where that runs the other way: it is a capability handed out on
	# purpose, and whoever holds it can already read the whole plan.
	#
	# Social unfurlers only, deliberately not search crawlers: the card carries
	# the plan's name, and a capability URL is not something to hand to an index.
	@unfurl {
		path /share/*
		header User-Agent *facebookexternalhit*
		header User-Agent *Twitterbot*
		header User-Agent *Slackbot*
		header User-Agent *Discordbot*
		header User-Agent *WhatsApp*
		header User-Agent *TelegramBot*
		header User-Agent *LinkedInBot*
		header User-Agent *Applebot*
		header User-Agent *Mastodon*
		header User-Agent *Iframely*
		header User-Agent *SkypeUriPreview*
		header User-Agent *embedly*
	}
	handle @unfurl {
		uri path_regexp ^/share/([^/]+)/?$ /share/$1/preview
		reverse_proxy {$UPSTREAM_API:api:3001}
	}

	# Every application route. A single-page app owns these paths and resolves
	# them itself, so anything not on disk falls back to its index.
	@app path /login /register /recent /settings /settings/* /admin /admin/* /workspace/* /plan/* /share/* /invite/*
	handle @app {
		root * {$APP_ROOT:/srv/app}
		try_files {path} /index.html
		file_server
	}

	# Everything else is the static site: the landing page, the guide, the docs
	# and the legal pages.
	handle {
		root * {$SITE_ROOT:/srv/site}
		try_files {path} {path}/ {path}/index.html
		file_server
	}

	# Serve the not-found page with a not-found status. Listing it in try_files
	# above would return it with 200, and a search engine would index the error
	# page as though it were content.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			root * {$SITE_ROOT:/srv/site}
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
