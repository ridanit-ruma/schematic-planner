generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities  OAuthIdentity[]
  memberships Membership[]
  sessions    Session[]
  apiKeys     ApiKey[]
  invitesSent Invite[]        @relation("InviteCreator")
}

model OAuthIdentity {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One refresh token. Only its hash is stored, so a database leak does not hand
/// over live sessions.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  projects Project[]
  invites  Invite[]
  apiKeys  ApiKey[]
}

/// A workspace holds projects; a project holds plans. The middle level exists
/// because one team plans several things at once, and a flat list of every plan
/// they have ever drawn stops being navigable quickly.
model Project {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plans     Plan[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(EDITOR)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  role        Role      @default(EDITOR)
  email       String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Plan {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @default("")
  /// Yjs document state: the write model. Every human drag and every MCP call
  /// lands here first.
  ydoc        Bytes?
  /// Projection of `ydoc`: the read model. Lists, search, share pages and export
  /// read this and never the CRDT. Nothing writes to it directly.
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  share   PlanShare?

  @@index([projectId])
}

model PlanShare {
  id        String    @id @default(cuid())
  planId    String    @unique
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

/// Bearer credential for the Remote MCP endpoint. Only the hash is stored;
/// `prefix` exists so the settings page can show which key is which.
///
/// A key belongs to a person, not to a workspace: someone works across several
/// and should not have to issue, paste and revoke a key per workspace. It acts
/// as its owner wherever they are a member. `workspaceId` survives only to keep
/// older narrower keys working and is null for anything issued now.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String
  name        String
  prefix      String
  hash        String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}
