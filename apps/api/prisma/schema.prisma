generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Standing in the instance itself, as distinct from standing in a workspace.
/// Almost everyone is a MEMBER: they own the workspaces they make and nothing
/// else. An OWNER can administer the instance -- who is on it, and who may join.
enum InstanceRole {
  OWNER
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  /// The first account made owns the instance. Somebody has to, and the
  /// alternative is a flag set by hand in the database before anyone can look
  /// at anything.
  instanceRole InstanceRole @default(MEMBER)
  /// Set when the account may not sign in. Suspended rather than deleted, so
  /// what it drew stays attributed to somebody.
  suspendedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  identities  OAuthIdentity[]
  memberships Membership[]
  sessions    Session[]
  apiKeys     ApiKey[]
  planChanges PlanChange[]
  invitesSent Invite[]        @relation("InviteCreator")
  plansTrashed    Plan[]    @relation("PlanTrasher")
  projectsTrashed Project[] @relation("ProjectTrasher")
  foldersTrashed  Folder[]  @relation("FolderTrasher")

  signupsInvited SignupInvite[] @relation("SignupInviteCreator")
  /// Which link this account came in through, when it came in through one.
  invitedVia     SignupInvite?  @relation("SignupInviteUsed", fields: [invitedViaId], references: [id], onDelete: SetNull)
  invitedViaId   String?

  @@index([invitedViaId])
}

model OAuthIdentity {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One refresh token. Only its hash is stored, so a database leak does not hand
/// over live sessions.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  projects Project[]
  invites  Invite[]
  apiKeys  ApiKey[]
}

/// A workspace holds projects; a project holds plans. The middle level exists
/// because one team plans several things at once, and a flat list of every plan
/// they have ever drawn stops being navigable quickly.
model Project {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// In the trash since. Set rather than deleting the row, so a project and the
  /// plans under it can be brought back whole.
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deletedBy User?     @relation("ProjectTrasher", fields: [deletedById], references: [id], onDelete: SetNull)
  plans     Plan[]
  folders   Folder[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(EDITOR)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  role        Role      @default(EDITOR)
  email       String?
  tokenHash   String    @unique
  /// The first characters of the token, so a list can say which link is which.
  /// Empty on anything issued before the list existed.
  prefix      String    @default("")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A drawer inside a project. One project holds several related plans and a
/// flat list of them stops being navigable at about a dozen, which is the same
/// reason the project level exists above it.
///
/// Folders do not nest. `project > folder > plan` is the depth people asked for,
/// and each level beyond that multiplies the places a plan can be hiding
/// without adding a way to find it.
model Folder {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// In the trash since. A folder in the trash takes its plans with it without
  /// marking them, the same way a project does.
  deletedAt   DateTime?
  deletedById String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deletedBy User?   @relation("FolderTrasher", fields: [deletedById], references: [id], onDelete: SetNull)
  plans     Plan[]

  @@index([projectId])
  @@index([projectId, deletedAt])
}

model Plan {
  id          String   @id @default(cuid())
  projectId   String
  /// Which drawer of the project it sits in. Null is the project's own top
  /// level, which is where every plan drawn before folders existed stays.
  folderId    String?
  title       String
  description String   @default("")
  /// Yjs document state: the write model. Every human drag and every MCP call
  /// lands here first.
  ydoc        Bytes?
  /// Projection of `ydoc`: the read model. Lists, search, share pages and export
  /// read this and never the CRDT. Nothing writes to it directly.
  snapshot    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// In the trash since. A plan is the unit people lose work in, so a delete
  /// hides it and a second, deliberate act destroys it.
  deletedAt   DateTime?
  deletedById String?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Emptied rather than cascaded: losing a folder must not lose the plans that
  /// were in it, so they fall back to the project's top level.
  folder    Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  deletedBy User?      @relation("PlanTrasher", fields: [deletedById], references: [id], onDelete: SetNull)
  share     PlanShare?
  changes   PlanChange[]

  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([folderId])
}

/// One entry in a plan's history. Written from the difference between two
/// versions of the document, so it covers the editor, the REST API and MCP
/// alike rather than only the paths that go through an operation.
model PlanChange {
  id     String @id @default(cuid())
  planId String
  userId String?
  /// Set when the change arrived over MCP, so the log can say an agent made it.
  apiKeyId String?
  /// The one act these entries came from. A single call can add forty nodes;
  /// without this the history has no way to tell that from forty separate
  /// decisions, and the screen cannot fold them back into the act.
  batchId  String?
  kind     String
  subject  String
  label    String
  detail   String?

  createdAt DateTime @default(now())

  plan Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
}

/// A way onto this instance, issued rather than shared.
///
/// What it replaces is one code everybody types: it cannot be given to one
/// person, cannot be taken back from them, and leaves no record of who used it.
/// This has a name on it, a limit, an expiry and an issuer, and the accounts
/// that came in through it point back at it.
///
/// Only the hash is stored, the way a session token is. A link that is lost is
/// gone -- issue another.
model SignupInvite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  /// The first characters of the token, so a list can say which link is which.
  prefix      String
  /// What it is for, in the issuer's own words. "For the design review", "Jae".
  label       String    @default("")
  /// How many accounts it may still make. Null is no limit.
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User   @relation("SignupInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  accounts  User[] @relation("SignupInviteUsed")

  @@index([createdById])
}

model PlanShare {
  id        String    @id @default(cuid())
  planId    String    @unique
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

/// Bearer credential for the Remote MCP endpoint. Only the hash is stored;
/// `prefix` exists so the settings page can show which key is which.
///
/// A key belongs to a person, not to a workspace: someone works across several
/// and should not have to issue, paste and revoke a key per workspace. It acts
/// as its owner wherever they are a member. `workspaceId` survives only to keep
/// older narrower keys working and is null for anything issued now.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String
  name        String
  prefix      String
  hash        String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}
