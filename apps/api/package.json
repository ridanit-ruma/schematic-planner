{
  "name": "@schematic/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "pnpm db:generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist .turbo src/generated *.tsbuildinfo"
  },
  "dependencies": {
    "@hocuspocus/server": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@schematic/exporter": "workspace:*",
    "@schematic/layout": "workspace:*",
    "@schematic/schema": "workspace:*",
    "@schematic/ydoc": "workspace:*",
    "argon2": "catalog:",
    "cookie-parser": "catalog:",
    "helmet": "catalog:",
    "nanoid": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@schematic/eslint-config": "workspace:*",
    "@schematic/typescript-config": "workspace:*",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
